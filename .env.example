# ElevenLabs, for `pnpm voice` (narration + timed captions). Copy to .env; .env is git-ignored.
ELEVENLABS_API_KEY=
# optional: a cloned voice id, and the model (eleven_multilingual_v2 by default)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# optional pacing: speed 0.7 (slowest) to 1.2, stability 0 to 1, style 0 to 1
ELEVENLABS_SPEED=0.86
ELEVENLABS_STABILITY=0.62
ELEVENLABS_STYLE=0.12
