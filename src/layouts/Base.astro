---
import "../styles/global.css";
import { site } from "../data/site";
const { title = site.title, description = site.description } = Astro.props;
const share = new URL("/assets/share.jpg", site.url).href;
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='22' y='5' rx='3' fill='%2335326f'/%3E%3Ccircle cx='10' cy='15' r='4' fill='%23fff'/%3E%3Ccircle cx='22' cy='15' r='4' fill='%23fff'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#ffffff">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={share}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href={site.url + "/"}>
  <link rel="apple-touch-icon" href="/assets/icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Playfair+Display:ital,wght@0,600;0,900;1,500;1,600;1,900&family=Outfit:wght@400&family=Share+Tech+Mono&family=Permanent+Marker&family=Geist:wght@600;800&display=swap" rel="stylesheet">
  <link rel="icon" href={favicon}>
</head>
<body>

<canvas id="tape" aria-hidden="true"></canvas>
<canvas id="tapeFront" aria-hidden="true"></canvas>

<slot />

<script>
  import "../scripts/site.js";
  import "../scripts/cassette3d.js";
</script>
</body>
</html>
