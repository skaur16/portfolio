---
// the hand-drawn hints: the pencil's note, and the one asking for sound
---
<button class="pencil-hit" id="pencilBtn" type="button" aria-label="Put the pencil in the reel" hidden></button>
<p class="pencil-note" id="pencilNote" aria-hidden="true" hidden><svg class="tap" viewBox="-14 -14 64 64" stroke-linecap="round" stroke-linejoin="round"><circle class="ring" cx="8" cy="8" r="9"/><g class="burst"><path d="M8-1V-7"/><path d="M-1 8H-7"/><path d="M1.5 1.5L-3 -3"/><path d="M15 1L19 -4"/><path d="M1 15L-4 19"/></g><path class="hand" d="M8 8L12.5 30L18 23.5L25.5 31L29.5 27L22 19.5L28.5 15z"/></svg><svg class="point" viewBox="0 0 44 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M41 15C30 21 17 19 5 9"/><path d="M4 19L4 8L15 7"/></svg><span id="pencilWord">click me first</span></p>

<p class="sound-note" id="soundNote"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="box" d="M3 9v6h4l5 4V5L7 9z"/><path class="wave" d="M15.5 9a4 4 0 0 1 0 6"/><path class="wave" d="M18.5 6a8.5 8.5 0 0 1 0 12"/><path class="wave" d="M21.5 3a13 13 0 0 1 0 18"/></svg><span id="soundWords">Turn your sound on. This tape talks.</span></p>
